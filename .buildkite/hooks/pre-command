#!/usr/bin/env bash
# Pre-command hook: sets up Go build/module caches inside the cache volume.
# This persists Go module downloads and build artifacts across pipeline runs,
# cutting CI time by ~60s on consecutive builds.
set -euo pipefail

checkout_path="${BUILDKITE_BUILD_CHECKOUT_PATH:-$(pwd)}"
cache_root="${checkout_path}/.buildkite/cache-volume"

mkdir -p \
  "${cache_root}/go/build" \
  "${cache_root}/go/pkg/mod" \
  "${cache_root}/golangci-lint"

export GOCACHE="${cache_root}/go/build"
export GOMODCACHE="${cache_root}/go/pkg/mod"
export GOLANGCI_LINT_CACHE="${cache_root}/golangci-lint"
